local combo = 1
local currentSwing = tick()
local timeBeforeComboReset = 3
local punchCooldown = 0.4
local punchDb = false

tool.Equipped:Connect(function()
	
	local vfx = {}
	
	local character = tool.Parent
	local humanoid = character:WaitForChild("Humanoid")
	
	local equipAnim = humanoid.Animator:LoadAnimation(tool.EquipAnimation)
	
	equipAnim:Play()
	
	local Aura = auraFolder:FindFirstChild(tool.Name)
	
	for _, v in pairs(character:GetChildren()) do
		
		if Aura.Vfx:FindFirstChild(v.Name) then
			for i, particle in pairs(Aura.Vfx:FindFirstChild(v.Name):GetChildren()) do
				local clonedParticle = particle:Clone()
				clonedParticle.Parent = v
				
				table.insert(vfx, clonedParticle)
			end
		end
		
	end
	
	tool.Unequipped:Once(function()
		for _, v in pairs(vfx) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = false
				task.delay(4, function()
					v:Destroy()
				end)
			elseif v:IsA("Attachment") then
				for i, particle in pairs(v:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Enabled = false
						task.delay(4, function()
							particle:Destroy()
						end)
					end
				end
			elseif v:IsA("Sound") then
				ts:Create(v, TweenInfo.new(1.5), {Volume = 0}):Play()
				game:GetService("Debris"):AddItem(v, 2)
			end
		end
	end)
	
end)

tool.Activated:Connect(function()
	
	local character = tool.Parent
	local humanoid = character:FindFirstChild("Humanoid")
	
	if CanCombat(character) == true and punchDb == false then
		punchDb = true
		

		local deltaTime = tick() - currentSwing

		if deltaTime < timeBeforeComboReset then

		else
			combo = 1
		end
		
		currentSwing = tick()
		
		print(combo)
		
		local punchAnim = humanoid.Animator:LoadAnimation(animationFolder:FindFirstChild("Punch"..combo))

		punchAnim:Play()
		
		local combatAction = Instance.new("Folder")
		combatAction.Name = 'CombatAction'
		combatAction.Parent = character
		
		task.delay(punchCooldown, function()
			combatAction:Destroy()
		end)
			
		local punchSwingSfx = assetFolder.Sfx["Punch Swing"]:Clone()
		punchSwingSfx.Parent = character.HumanoidRootPart
		punchSwingSfx:Play()
		game:GetService("Debris"):AddItem(punchSwingSfx, 1)
		
		wait(0.25)
		
		local infoTable = {
			HitboxDB = 0.25;
			Range = Vector3.new(6, 5, 6);
			RangeOffset = CFrame.new(0,0,2.5);
		}

		local Hit

		local Hitbox = HitboxCreator(character.HumanoidRootPart, infoTable.Range, infoTable.RangeOffset, 0.25, false)
		Hit = Hitbox.Hit:Connect(function(Victim)
			print(Victim, "RAHHH")
			local eroot = Victim.HumanoidRootPart

			if Victim ~= character and Victim:FindFirstChild("HumanoidRootPart") and Victim.Parent ~= character and Victim.Blocking.Value == false  and Victim.CanGetCombated.Value == true and Victim.Humanoid.Health > 0 then
				if character.CanFight.Value == true and character.Blocking.Value == false then
					attack(Victim, character, combo, false)
				end
			
			elseif Victim ~= character and Victim:FindFirstChild("HumanoidRootPart") and Victim.Parent ~= character and Victim.Blocking.Value == true  and Victim.CanGetCombated.Value == true and Victim.Humanoid.Health > 0 then
				if character.CanFight.Value == true and character.Blocking.Value == false then
					attack(Victim, character, combo, true)
				end
				
			end

			task.delay(0.25, function()
				Hit:Disconnect() 
				
			end)
		end)
		
		task.delay(0.25, function()
			if combo ~= 5 then
				combo += 1
			else
				combo = 1
				wait(punchCooldown * 2)
			end

			punchDb = false
		end)
		
	end
	
end)

